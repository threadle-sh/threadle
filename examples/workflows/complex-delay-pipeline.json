{
  "$schema": "threadle/graph@1",
  "name": "Example · Complex delay pipeline",
  "kind": "workflow",
  "params": [
    {
      "name": "topic",
      "type": "text",
      "default": "ship the subgraph demo",
      "description": "What the pipeline pretends to process"
    },
    {
      "name": "runId",
      "type": "text",
      "default": "run-local",
      "description": "Stamp written into normalize / assemble"
    }
  ],
  "settings": {
    "ply": 2
  },
  "viewport": {
    "x": 0,
    "y": 40,
    "zoom": 0.45
