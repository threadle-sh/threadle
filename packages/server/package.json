{
  "name": "threadle",
  "version": "1.2.1",
  "description": "Local-first multi-provider viewer for Claude Code, opencode, Cursor Agent, Antigravity, Codex, Copilot, Grok Build and Muse sessions — with an optional Workflows addon.",
  "type": "module",
  "license": "MIT",
  "author": "Fabian Bienk (https://github.com/zFarbp)",
  "homepage": "https://threadle.sh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/threadle-sh/threadle.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/threadle-sh/threadle/issues"
  },
  "keywords": [
    "threadle",
    "claude-code",
    "opencode",
    "cursor",
    "codex",
    "copilot",
    "grok",
    "muse",
    "agent",
    "workflow",
    "viewer",
    "observability"
  ],
  "bin": {
    "threadle": "dist/cli.js",
    "threadle-workflows": "dist/workflows-bin.js"
  },
  "files": [
    "dist",
    "web-dist",
    "web-dist-workflows",
    "data"
  ],
  "scripts": {
    "dev": "THREADLE_VIEWER_URL=http://localhost:5173 THREADLE_WORKFLOWS_URL=http://localhost:5174 tsx watch src/cli.ts --no-open --triggers",
    "build": "tsup",
    "test": "vitest run",
    "check:upstream": "npm run check:upstream -w @threadle/core",
    "update:pricing": "node ../../scripts/update-models-pricing.mjs",
    "prepublishOnly": "npm run build --prefix ../web && npm run build --prefix ../workflows-web && npm run build",
    "pack:smoke": "npm run prepublishOnly && npm pack --dry-run"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/client": "^2.2.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "chokidar": "^5.0.0",
    "execa": "^9.5.2",
    "gray-matter": "^4.0.3",
    "hono": "^4.13.12",
    "open": "^10.1.0",
    "smol-toml": "^1.9.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@threadle/core": "*",
    "@threadle/shared": "*",
    "@threadle/workflows-server": "*",
    "@threadle/workflows-shared": "*",
    "@types/node": "^26.6.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
